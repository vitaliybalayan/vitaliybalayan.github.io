---
import Layout from '../layouts/Layout.astro';
import { getPosts, groupByYear, kindLabels, postHref, shortDate } from '../lib/posts';
import { localePath, t, toLang } from '../lib/i18n';

const lang = toLang(Astro.currentLocale);
const tr = t(lang);
const years = groupByYear(await getPosts(lang));
---
<Layout title={`${tr.archive.title} — ${tr.name}`} description={tr.archive.description} nav="archive">
  <main class="wrap">
    <section class="intro">
      <h1>{tr.archive.title}</h1>
      <div class="intro-meta mono">{years.map(([y, items]) => <a href={localePath(lang, `/archive/${y}/`)}><b>{y}</b> · {items.length}</a>)}</div>
    </section>

    {years.map(([year, items]) => (
      <section class="month">
        <h2 class="month-label"><a href={localePath(lang, `/archive/${year}/`)}>{year}</a></h2>
        <ol class="archive-list">
          {items.map((p) => (
            <li data-kind={p.data.kind}>
              <time class="mono muted">{shortDate(p.data.date, lang)}</time>
              <a href={postHref(p)}>{p.data.title}</a>
              <span class="mono kind">{kindLabels(lang)[p.data.kind]}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</Layout>
