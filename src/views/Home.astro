---
import Layout from '../layouts/Layout.astro';
import Feed from '../components/Feed.astro';
import FilterBar from '../components/FilterBar.astro';
import { getPosts, HOME_LIMIT } from '../lib/posts';
import { dateLocale, localePath, t, toLang } from '../lib/i18n';

const lang = toLang(Astro.currentLocale);
const tr = t(lang);
const posts = await getPosts(lang);
const latest = posts[0]?.data.date;
---
<Layout title={tr.home.title} description={tr.home.description} nav="feed">
  <main class="wrap">
    <section class="intro">
      <h1>{tr.home.h1}</h1>
      <p>{tr.home.intro}</p>
      <div class="intro-meta mono">
        <span><b>{posts.length}</b> {tr.entries}</span>
        {latest && <span>{tr.home.updated} <b>{latest.toLocaleDateString(dateLocale[lang])}</b></span>}
      </div>
    </section>

    <FilterBar posts={posts} active="all" />
    <Feed posts={posts.slice(0, HOME_LIMIT)} />

    {posts.length > HOME_LIMIT && (
      <nav class="pager mono"><span /><a href={localePath(lang, '/archive/')}>{tr.home.fullArchive} · {posts.length} →</a><span /></nav>
    )}
  </main>
</Layout>
