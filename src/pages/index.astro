---
import Layout from '../layouts/Layout.astro';
import Feed from '../components/Feed.astro';
import FilterBar from '../components/FilterBar.astro';
import { getPosts, HOME_LIMIT } from '../lib/posts';

const posts = await getPosts();
const latest = posts[0]?.data.date;
---
<Layout title="Виталий Балаян — лог работ" description="Хронология моих работ, релизов и заметок." nav="feed">
  <main class="wrap">
    <section class="intro">
      <h1>Лог работ</h1>
      <p>Лента работ, релизов и заметок — между блогом и changelog. Новое сверху.</p>
      <div class="intro-meta mono">
        <span><b>{posts.length}</b> записей</span>
        {latest && <span>обновлено <b>{latest.toLocaleDateString('ru-RU')}</b></span>}
      </div>
    </section>

    <FilterBar posts={posts} active="all" />
    <Feed posts={posts.slice(0, HOME_LIMIT)} />

    {posts.length > HOME_LIMIT && (
      <nav class="pager mono"><span /><a href="/archive/">Весь архив · {posts.length} →</a><span /></nav>
    )}
  </main>
</Layout>
