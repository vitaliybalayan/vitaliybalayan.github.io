---
import Layout from '../../layouts/Layout.astro';
import { getPosts, groupByYear, kindLabels, shortDate } from '../../lib/posts';

const years = groupByYear(await getPosts());
---
<Layout title="Архив — Виталий Балаян" description="Все записи по годам" nav="archive">
  <main class="wrap">
    <section class="intro">
      <h1>Архив</h1>
      <div class="intro-meta mono">{years.map(([y, items]) => <a href={`/archive/${y}/`}><b>{y}</b> · {items.length}</a>)}</div>
    </section>

    {years.map(([year, items]) => (
      <section class="month">
        <h2 class="month-label"><a href={`/archive/${year}/`}>{year}</a></h2>
        <ol class="archive-list">
          {items.map((p) => (
            <li data-kind={p.data.kind}>
              <time class="mono muted">{shortDate(p.data.date)}</time>
              <a href={`/posts/${p.id}/`}>{p.data.title}</a>
              <span class="mono kind">{kindLabels[p.data.kind]}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</Layout>
