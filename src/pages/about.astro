---
import Layout from '../layouts/Layout.astro';
import { getPosts, getTags, tagSlug } from '../lib/posts';

const tags = getTags(await getPosts()).slice(0, 12);
---
<Layout title="Обо мне — Виталий Балаян" description="Software Engineer: веб, мобильная разработка, backend и ИИ." nav="about">
  <main class="prose-wrap">
    <section class="intro">
      <h1>Обо мне</h1>
      <div class="prose">
        <p>Я Виталий — software engineer. Делаю веб- и мобильные приложения, backend-системы и инструменты.</p>
        <p>Здесь я веду лог: что сделал, что выпустил, что снял</p>
      </div>
    </section>

    <div class="about-grid">
      <div>
        <h3>Связаться</h3>
        <ul>
          <li><a href="https://t.me/vitaliybalayan">Telegram ↗</a></li>
          <li><a href="https://instagram.com/vitaliybalayan">Instagram ↗</a></li>
          <li><a href="https://github.com/vitaliybalayan">GitHub ↗</a></li>
          <li><a href="https://wa.me/77086227977">WhatsApp ↗</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      <div>
        <h3>Темы</h3>
        <div class="entry-tags">{tags.map(([t, n]) => <a class="tag" href={`/tags/${tagSlug(t)}/`}>#{t} {n}</a>)}</div>
      </div>
    </div>
  </main>
</Layout>
