---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MediaGrid from '../../components/MediaGrid.astro';
import { getPosts, formatDate, kindLabels, tagSlug, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { title, date, kind, summary, project, version, tags, cover, media, links } = post.data;
const { Content } = await render(post);
const nav = kind === 'work' ? 'works' : 'feed';
---
<Layout title={`${title} — Виталий Балаян`} description={summary ?? title} image={cover?.src ?? media[0]?.src} nav={nav}>
  <main data-pagefind-body>
    <header class="prose-wrap post-head" data-kind={kind}>
      <a class="back" href="/" data-pagefind-ignore>← Лента</a>
      <div class="entry-meta mono" data-pagefind-ignore>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span class="kind">{kindLabels[kind]}</span>
        {project && <span>{project}</span>}
        {version && <span class="version">{version}</span>}
      </div>
      <h1 data-pagefind-meta="title">{title}</h1>
      <span hidden data-pagefind-filter="kind">{kindLabels[kind]}</span>
      {summary && <p class="lead">{summary}</p>}
    </header>

    {cover && <div class="post-cover"><MediaGrid items={[cover]} eager /></div>}

    <article class="prose-wrap">
      <div class="prose"><Content /></div>

      {media.length > 0 && <div class="post-gallery"><MediaGrid items={media} /></div>}

      {links.length > 0 && (
        <div class="post-links">{links.map((l) => <a class="btn-link" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}</div>
      )}

      {tags.length > 0 && (
        <div class="entry-tags">{tags.map((t) => <a class="tag" href={`/tags/${tagSlug(t)}/`}>#{t}</a>)}</div>
      )}

      <nav class="post-nav" data-pagefind-ignore aria-label="Соседние записи">
        {older && <a href={`/posts/${older.id}/`}><span class="mono">← раньше</span><strong>{older.data.title}</strong></a>}
        {newer && <a class="next" href={`/posts/${newer.id}/`}><span class="mono">позже →</span><strong>{newer.data.title}</strong></a>}
      </nav>
    </article>
  </main>
</Layout>
