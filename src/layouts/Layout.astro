---
import '../styles/global.css';
import { DEFAULT_OG_IMAGE, INDEXING } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  nav?: 'feed' | 'works' | 'archive' | 'about' | 'search' | null;
}
const { title, description, image = DEFAULT_OG_IMAGE, nav = null } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const links = [
  { id: 'feed', href: '/', label: 'Лента' },
  { id: 'works', href: '/works/', label: 'Работы' },
  { id: 'archive', href: '/archive/', label: 'Архив' },
  { id: 'about', href: '/about/', label: 'Обо мне' },
] as const;
---
<!doctype html>
<html lang="ru">
  <head>
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content={INDEXING ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Виталий Балаян" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <header class="wrap topbar">
      <a class="brand" href="/">
        <span class="brand-mark">VB</span>
        <span class="brand-name">Виталий Балаян<small>Software Engineer · лог работ</small></span>
      </a>
      <div class="topbar-actions">
      <a class="theme-toggle" href="/search/" aria-label="Поиск" aria-current={nav === 'search' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Переключить тему">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      </div>
    </header>

    <slot />

    <footer class="wrap footer">
      <span>© {new Date().getFullYear()} Виталий Балаян</span>
      <span><a href="https://t.me/vitaliybalayan">Telegram</a> · <a href="https://instagram.com/vitaliybalayan">Instagram</a> · <a href="https://github.com/vitaliybalayan">GitHub</a> · <a href="/rss.xml">RSS</a></span>
    </footer>

    <nav class="dock glass" aria-label="Основная навигация" data-dock>
      {links.map((l) => <a href={l.href} data-nav={l.id} aria-current={nav === l.id ? 'page' : undefined}>{l.label}</a>)}
    </nav>

    <script>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
