---
import '../styles/global.css';
import { DEFAULT_OG_IMAGE, INDEXING, TELEGRAM_URL } from '../lib/site';
import { localePath, stripLang, t, toLang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  nav?: 'feed' | 'works' | 'archive' | 'about' | 'search' | null;
  /** Путь этой же страницы без языкового префикса, если на другом языке он отличается. */
  alternate?: string;
}
const { title, description, image = DEFAULT_OG_IMAGE, nav = null } = Astro.props;
const lang = toLang(Astro.currentLocale);
const other = lang === 'ru' ? 'en' : 'ru';
const tr = t(lang);
const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, site);
const basePath = Astro.props.alternate ?? stripLang(Astro.url.pathname);
const alternates = { [lang]: stripLang(Astro.url.pathname), [other]: basePath };

const links = (['feed', 'works', 'archive', 'about'] as const).map((id) => ({
  id,
  href: localePath(lang, { feed: '/', works: '/works/', archive: '/archive/', about: '/about/' }[id]),
  label: tr.nav[id],
}));
---
<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content={INDEXING ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonicalURL} />
    {Object.entries(alternates).map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(localePath(l as typeof lang, p), site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.ru, site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f3f1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title={tr.name} href={localePath(lang, '/rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={tr.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <!-- Yandex.Metrika counter -->
    <script is:inline type="text/javascript">
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=113828546', 'ym');

      ym(113828546, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body>
    <noscript><div><img src="https://mc.yandex.ru/watch/113828546" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <header class="wrap topbar">
      <a class="brand" href={localePath(lang, '/')}>
        <span class="brand-mark">VB</span>
        <span class="brand-name">{tr.name}<small>Software Engineer · {tr.tagline}</small></span>
      </a>
      <div class="topbar-actions">
      <a class="theme-toggle lang-toggle mono" href={localePath(other, alternates[other])} hreflang={other} lang={other} aria-label={tr.switchTo} title={tr.switchTo}>{tr.switchShort}</a>
      <a class="theme-toggle" href={localePath(lang, '/search/')} aria-label={tr.searchAria} aria-current={nav === 'search' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label={tr.themeAria}>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      </div>
    </header>

    <slot />

    <footer class="wrap footer">
      <span>© {new Date().getFullYear()} {tr.name}</span>
      <span><a href="https://t.me/vitaliybalayan">Telegram</a> · <a href="https://instagram.com/vitaliybalayan">Instagram</a> · <a href="https://github.com/vitaliybalayan">GitHub</a> · <a href={localePath(lang, '/rss.xml')}>RSS</a></span>
    </footer>

    <nav class="dock glass" aria-label={tr.navAria} data-dock>
      {links.map((l) => <a href={l.href} data-nav={l.id} aria-current={nav === l.id ? 'page' : undefined}>{l.label}</a>)}
      <a class="dock-cta" href={TELEGRAM_URL} target="_blank" rel="noopener" aria-label={tr.telegramAria} title={tr.telegramAria}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.3 13.1l-4.8-1.5c-1-.3-1.1-1 .2-1.5L20.6 2.8c.9-.3 1.6.2 1.3 1.5z"/></svg>
        <span>{tr.telegram}</span>
      </a>
    </nav>

    <script>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
