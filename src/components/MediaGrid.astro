---
interface MediaItem {
  type: 'image' | 'video';
  src: string;
  alt: string;
  caption?: string;
  poster?: string;
}
interface Props {
  items: MediaItem[];
  href?: string;
  eager?: boolean;
}
const { items, href, eager = false } = Astro.props;
const shown = items.slice(0, 4);
---
{shown.length > 0 && (
  <div class="media-grid" data-count={shown.length}>
    {shown.map((m, i) => (
      <figure class="media">
        {m.type === 'video' ? (
          <video src={m.src} poster={m.poster} controls playsinline preload="metadata" aria-label={m.alt}></video>
        ) : href ? (
          <a class="media-link" href={href} tabindex="-1">
            <img src={m.src} alt={m.alt} loading={eager && i === 0 ? 'eager' : 'lazy'} decoding="async" />
          </a>
        ) : (
          <img src={m.src} alt={m.alt} loading={eager && i === 0 ? 'eager' : 'lazy'} decoding="async" />
        )}
        {m.caption && <figcaption class="glass">{m.caption}</figcaption>}
      </figure>
    ))}
  </div>
)}
