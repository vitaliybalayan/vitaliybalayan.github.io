---
import Entry from './Entry.astro';
import { groupByMonth, type Post } from '../lib/posts';
import { t, toLang } from '../lib/i18n';

interface Props { posts: Post[] }
const lang = toLang(Astro.currentLocale);
const months = groupByMonth(Astro.props.posts, lang);
---
{months.length === 0 && <p class="muted empty">{t(lang).empty}</p>}
{months.map(({ label, items }) => (
  <section class="month">
    <h2 class="month-label">{label.split(' ')[0]}<span class="mono">{label.split(' ')[1]}</span></h2>
    <ol class="entries">{items.map((post) => <Entry post={post} />)}</ol>
  </section>
))}
